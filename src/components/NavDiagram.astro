---
// The site's navigation, drawn as the commutative diagram of its category.
// Geometry is computed at build time; the output is a static SVG.
import {
  arrows,
  layout,
  leq,
  meta,
  pages,
  type Loop,
  type Page,
} from "../category";

interface Props {
  page?: Page;
}
const { page } = Astro.props;

const COL = 140; // horizontal distance between columns
const ROW = 76; // vertical distance between rows
const FONT = 16;
const CHAR = FONT / 2; // Iosevka's advance width is exactly 0.5em
const PAD_X = 8; // gap between a label and an arrow touching its side
const HALF_H = 12; // half the height of a node's box
const GAP = 3; // extra breathing room at each end of an arrow
const LOOP = 36; // bézier control-point offset of the identity loop

type Pt = { x: number; y: number };
const pos = (p: Page): Pt => ({
  x: layout[p].at[0] * COL,
  y: layout[p].at[1] * ROW,
});
const halfW = (p: Page) => (meta[p].title.length * CHAR) / 2 + PAD_X;
const unit = (a: Pt, b: Pt): Pt => {
  const len = Math.hypot(b.x - a.x, b.y - a.y);
  return { x: (b.x - a.x) / len, y: (b.y - a.y) / len };
};
const f = (n: number) => n.toFixed(1);

// Distance from a box's centre to its edge along the unit vector u.
const toEdge = (p: Page, u: Pt) =>
  Math.min(
    u.x === 0 ? Infinity : halfW(p) / Math.abs(u.x),
    u.y === 0 ? Infinity : HALF_H / Math.abs(u.y),
  ) + GAP;

const edges = arrows.map(([a, b, why]) => {
  const A = pos(a);
  const B = pos(b);
  const u = unit(A, B);
  const s = toEdge(a, u);
  const e = toEdge(b, u);
  return {
    x1: A.x + u.x * s,
    y1: A.y + u.y * s,
    x2: B.x - u.x * e,
    y2: B.y - u.y * e,
    title: `${meta[a].title} → ${meta[b].title}: ${why}`,
    // Every page whose up-set contains this arrow.
    reachedBy: pages.filter((q) => leq(q, a)).join(" "),
  };
});

// Every page with a (non-identity) morphism to p.
const reachedBy = (p: Page) =>
  pages.filter((q) => q !== p && leq(q, p)).join(" ");

// Pointing at a page lights up everything it reaches: the arrows and objects
// of its up-set. One rule per page, generated here because the selectors
// depend on the category.
const reachCss = pages
  .map((p) => {
    const on = `.diagram:has([data-page="${p}"]:is(:hover, :focus-visible))`;
    return (
      `${on} .arrow[data-reached-by~="${p}"] .stroke` +
      `{stroke:var(--fg);marker-end:url(#nav-head-on)}` +
      `${on} .obj[data-reached-by~="${p}"] text{fill:var(--fg)}`
    );
  })
  .join("");

// The identity loop leaves and re-enters a node on its free side.
const DIRS: Record<Loop, Pt> = {
  up: { x: 0, y: -1 },
  down: { x: 0, y: 1 },
  left: { x: -1, y: 0 },
  right: { x: 1, y: 0 },
};
const loop = (p: Page) => {
  const c = pos(p);
  const d = DIRS[layout[p].loop];
  const n = { x: -d.y, y: d.x }; // perpendicular to d
  const edge = d.x === 0 ? HALF_H : halfW(p);
  const at = (along: number, across: number) => ({
    x: c.x + d.x * (edge + along) + n.x * across,
    y: c.y + d.y * (edge + along) + n.y * across,
  });
  const [s, c1, c2, e] = [at(0, -7), at(LOOP, -21), at(LOOP, 21), at(0, 7)];
  return {
    d: `M ${f(s.x)} ${f(s.y)} C ${f(c1.x)} ${f(c1.y)}, ${f(c2.x)} ${f(c2.y)}, ${f(e.x)} ${f(e.y)}`,
    label: at(LOOP * 0.75 + (d.x === 0 ? 10 : 14), 0),
  };
};

// Bounds cover every node and every page's identity loop, so the diagram is
// the same size on every page.
const extents: Pt[] = pages.flatMap((p) => {
  const c = pos(p);
  const { label } = loop(p);
  return [
    { x: c.x - halfW(p), y: c.y - HALF_H },
    { x: c.x + halfW(p), y: c.y + HALF_H },
    { x: label.x - 10, y: label.y - 10 },
    { x: label.x + 10, y: label.y + 10 },
  ];
});
const minX = Math.min(...extents.map((p) => p.x)) - 2;
const maxX = Math.max(...extents.map((p) => p.x)) + 2;
const minY = Math.min(...extents.map((p) => p.y)) - 2;
const maxY = Math.max(...extents.map((p) => p.y)) + 2;
const viewBox = [minX, minY, maxX - minX, maxY - minY].map(f).join(" ");
---

<nav aria-label="Site" data-page={page}>
  <svg
    class="diagram"
    viewBox={viewBox}
    role="group"
    style={`--w: ${f(maxX - minX)}px; aspect-ratio: ${f(maxX - minX)} / ${f(maxY - minY)}`}
  >
    <style is:inline set:html={reachCss} />
    <defs>
      <marker
        id="nav-head"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path class="head" d="M 1 1 L 9 5 L 1 9"></path>
      </marker>
      <marker
        id="nav-head-id"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path class="head head-id" d="M 1 1 L 9 5 L 1 9"></path>
      </marker>
      <marker
        id="nav-head-on"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path class="head head-on" d="M 1 1 L 9 5 L 1 9"></path>
      </marker>
    </defs>

    {
      edges.map((e) => (
        <g class="arrow" data-reached-by={e.reachedBy}>
          <title>{e.title}</title>
          <line class="hover" x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} />
          <line
            class="stroke"
            x1={e.x1}
            y1={e.y1}
            x2={e.x2}
            y2={e.y2}
            marker-end="url(#nav-head)"
          />
        </g>
      ))
    }

    {
      pages.map((p) => {
        const { x, y } = pos(p);
        // Hooks for the reachability rules and the keyboard shortcuts.
        const data = {
          "data-page": p,
          "data-reached-by": reachedBy(p),
          "data-col": layout[p].at[0],
          "data-row": layout[p].at[1],
        };
        const box = (
          <rect
            class="hit"
            x={x - halfW(p)}
            y={y - HALF_H}
            width={2 * halfW(p)}
            height={2 * HALF_H}
          />
        );
        const label = (
          <text x={x} y={y}>
            {meta[p].title}
          </text>
        );
        if (p !== page)
          return (
            <a class="obj" href={meta[p].href} {...data}>
              {box}
              {label}
            </a>
          );
        const l = loop(p);
        return (
          <g
            class="obj current"
            tabindex="0"
            aria-current="page"
            aria-label={`${meta[p].title} (current page)`}
            {...data}
          >
            <path
              class="id"
              d={l.d}
              pathLength="1"
              marker-end="url(#nav-head-id)"
            />
            <text class="id-label" x={l.label.x} y={l.label.y}>
              id
            </text>
            {box}
            {label}
          </g>
        );
      })
    }
  </svg>
  <p class="trail" hidden></p>
</nav>

<style>
  nav {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* The composite of the arrows followed to get here; see scripts/trail.ts. */
  .trail {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
    text-align: center;
  }

  .diagram {
    display: block;
    width: 100%;
    max-width: var(--w);
    height: auto;
    overflow: visible;
    font-size: 16px;
  }

  text {
    fill: var(--link);
    text-anchor: middle;
    dominant-baseline: central;
  }

  .arrow .stroke {
    stroke: var(--muted);
    stroke-width: 1.25;
    transition: stroke 0.15s;
  }

  /* A wide invisible stroke so the arrow's tooltip is easy to hit. */
  .arrow .hover {
    stroke: transparent;
    stroke-width: 10;
  }

  .arrow:hover .stroke {
    stroke: var(--fg);
  }

  .head {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hit {
    fill: transparent;
  }

  .obj {
    cursor: pointer;
    outline: none;
  }

  .obj:hover text,
  .obj:focus-visible text {
    fill: var(--fg);
    text-decoration: underline;
  }

  .obj:focus-visible .hit {
    stroke: var(--link);
    stroke-width: 1;
    stroke-dasharray: 2 2;
  }

  .current {
    cursor: default;
  }

  .current text {
    fill: var(--fg);
    font-weight: 700;
  }

  .current:hover text,
  .current:focus-visible text {
    text-decoration: none;
  }

  /* The identity arrow draws itself when you point at where you already are. */
  .id {
    fill: none;
    stroke: var(--link);
    stroke-width: 1.25;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    transition:
      stroke-dashoffset 0.35s ease-out,
      opacity 0.15s;
  }

  .head-id {
    stroke: var(--link);
  }

  .head-on {
    stroke: var(--fg);
  }

  .current text.id-label {
    fill: var(--link);
    font-weight: 400;
    font-style: italic;
    opacity: 0;
    transition: opacity 0.2s 0.15s;
  }

  .current:hover .id,
  .current:focus-visible .id {
    stroke-dashoffset: 0;
    opacity: 1;
  }

  .current:hover .id-label,
  .current:focus-visible .id-label {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .id,
    .current text.id-label {
      transition: none;
    }
  }
</style>
