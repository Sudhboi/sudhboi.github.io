---
import "../styles/global.css";
import NavDiagram from "../components/NavDiagram.astro";
import { meta, type Page } from "../category";

// Used directly (props) or as a Markdown layout (frontmatter).
const props = Astro.props.frontmatter ?? Astro.props;
const page: Page | undefined = props.page;
const title: string = props.title ?? (page ? meta[page].title : "");
const docTitle = page === "home" ? "Sudhir Krisna" : `${title} · Sudhir Krisna`;
// Kept out of search results (and out of the sitemap: see astro.config.ts).
const noindex: boolean = props.noindex ?? false;
const url = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

// Who the site is about, for search engines; on the home page only.
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Sudhir Krisna",
  url: Astro.site,
  jobTitle: "Research Assistant",
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "University of New Brunswick",
  },
  knowsAbout: ["Functional programming", "Type theory", "Reproducibility"],
  sameAs: [
    "https://github.com/Sudhboi",
    "https://www.linkedin.com/in/sudhir-krisna",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{docTitle}</title>
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <link rel="canonical" href={url} />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sudhir Krisna" />
    <meta property="og:title" content={docTitle} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Sudhir Krisna, above the site's navigation diagram"
    />
    <meta name="twitter:card" content="summary_large_image" />
    {
      page === "home" && (
        <script type="application/ld+json" set:html={JSON.stringify(person)} />
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/IosevkaTerm-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Apply a saved theme before first paint (see scripts/theme.ts). -->
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <!-- Hide the page until a pending trip along the diagram has played
         (see scripts/travel.ts). Never for more than two seconds. -->
    <script is:inline>
      try {
        const trip = JSON.parse(sessionStorage.getItem("travel") ?? "null");
        const nav = performance.getEntriesByType("navigation")[0];
        const arriving =
          (trip && trip.href === location.pathname && Date.now() - trip.t < 5000) ||
          (nav && nav.type === "back_forward" && sessionStorage.getItem("shown"));
        if (arriving && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
          const root = document.documentElement;
          root.dataset.travel = "";
          setTimeout(() => delete root.dataset.travel, 2000);
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <button class="theme-toggle" type="button" hidden>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
      </svg>
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        ></path>
      </svg>
    </button>
    <div class="sidebar">
      <header>
        <div class="identity">
          <a
            class="logo"
            href="/"
            aria-current={page === "home" ? "page" : undefined}
            >Sudhir Krisna<span class="abs" aria-hidden="true"> :: Name</span></a
          >
          <ul class="elsewhere" aria-label="Elsewhere">
            <li>
              <a href="https://github.com/Sudhboi">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path
                    d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
                  ></path>
                </svg>
                GitHub
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/in/sudhir-krisna">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                  ></path>
                </svg>
                LinkedIn
              </a>
            </li>
          </ul>
        </div>
        <NavDiagram page={page} />
      </header>
      <footer>
        <p>Built with Astro.*</p>
        <p class="keys-hint" hidden>
          Press <kbd>?</kbd> for keyboard shortcuts.
        </p>
        <p class="footnote">
          * Built with LLM assistance; I refuse to write a single line of
          JavaScript.
        </p>
      </footer>
    </div>
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <dialog class="keys" aria-labelledby="keys-title">
      <h2 id="keys-title">Keyboard shortcuts</h2>
      <dl>
        <dt><kbd>h</kbd> <kbd>j</kbd> <kbd>k</kbd> <kbd>l</kbd></dt>
        <dd>move around the diagram</dd>
        <dt><kbd>Enter</kbd></dt>
        <dd>follow the arrow to that page</dd>
        <dt><kbd>g</kbd> <kbd>h</kbd></dt>
        <dd>go home</dd>
        <dt><kbd>H</kbd> <kbd>L</kbd></dt>
        <dd>back / forward</dd>
        <dt><kbd>t</kbd></dt>
        <dd>switch light / dark</dd>
        <dt><kbd>c</kbd></dt>
        <dd>chase a square of the diagram (it commutes)</dd>
        <dt><kbd>:</kbd></dt>
        <dd>command line (<kbd>↑</kbd> <kbd>↓</kbd> pick, <kbd>Tab</kbd> completes, <kbd>Esc</kbd> closes)</dd>
        <dt><kbd>?</kbd></dt>
        <dd>show or hide this list</dd>
      </dl>
      <form method="dialog">
        <button>Close</button>
      </form>
    </dialog>
    <!-- The ":" command line (scripts/prompt.ts). Hidden until opened. -->
    <form class="prompt" hidden>
      <pre class="out" aria-live="polite" hidden></pre>
      <ul class="suggestions" id="prompt-list" role="listbox" aria-label="Suggestions" hidden></ul>
      <div class="line">
        <label for="prompt-input">:</label>
        <span class="field">
          <span class="ghost" aria-hidden="true"></span>
          <input
            id="prompt-input"
            type="text"
            role="combobox"
            aria-label="Command"
            aria-controls="prompt-list"
            aria-expanded="false"
            aria-autocomplete="list"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
          />
        </span>
      </div>
    </form>
    <!-- Always at the bottom of the window; opens the command line. Hidden
         until scripts/prompt.ts runs, and while the command line is open. -->
    <button class="prompt-hint" type="button" hidden>
      <span class="keyed">Press <kbd>:</kbd> to open the prompt</span>
      <span class="touch"><kbd>:</kbd> Open the prompt</span>
    </button>
    <script>
      import "../scripts/nav-keys";
      import "../scripts/trail";
      import "../scripts/theme";
      import "../scripts/travel";
      import "../scripts/prompt";
      import "../scripts/chase";
    </script>
  </body>
</html>
