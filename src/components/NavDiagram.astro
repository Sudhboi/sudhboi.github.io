---
// The site's navigation, drawn as the commutative diagram of its category.
// Geometry is computed at build time; the output is a static SVG.
import {
  arrows,
  layout,
  leq,
  meta,
  pages,
  squares,
  type Loop,
  type Page,
} from "../category";

interface Props {
  page?: Page;
}
const { page } = Astro.props;

const COL = 140; // horizontal distance between columns
const ROW = 76; // vertical distance between rows
const FONT = 16;
const CHAR = FONT / 2; // Iosevka's advance width is exactly 0.5em
const PAD_X = 8; // gap between a label and an arrow touching its side
const HALF_H = 12; // half the height of a node's box
const GAP = 3; // extra breathing room at each end of an arrow
const LOOP = 36; // bézier control-point offset of the identity loop

type Pt = { x: number; y: number };
const pos = (p: Page): Pt => ({
  x: layout[p].at[0] * COL,
  y: layout[p].at[1] * ROW,
});
const halfW = (p: Page) => (meta[p].title.length * CHAR) / 2 + PAD_X;
const unit = (a: Pt, b: Pt): Pt => {
  const len = Math.hypot(b.x - a.x, b.y - a.y);
  return { x: (b.x - a.x) / len, y: (b.y - a.y) / len };
};
const f = (n: number) => n.toFixed(1);

// Distance from a box's centre to its edge along the unit vector u.
const toEdge = (p: Page, u: Pt) =>
  Math.min(
    u.x === 0 ? Infinity : halfW(p) / Math.abs(u.x),
    u.y === 0 ? Infinity : HALF_H / Math.abs(u.y),
  ) + GAP;

const edges = arrows.map(([a, b, why]) => {
  const A = pos(a);
  const B = pos(b);
  const u = unit(A, B);
  const s = toEdge(a, u);
  const e = toEdge(b, u);
  return {
    from: a,
    to: b,
    x1: A.x + u.x * s,
    y1: A.y + u.y * s,
    x2: B.x - u.x * e,
    y2: B.y - u.y * e,
    title: `${meta[a].title} → ${meta[b].title}: ${why}`,
    // Every page whose up-set contains this arrow.
    reachedBy: pages.filter((q) => leq(q, a)).join(" "),
  };
});

// Every page with a (non-identity) morphism to p.
const reachedBy = (p: Page) =>
  pages.filter((q) => q !== p && leq(q, p)).join(" ");

// Pointing at a page lights up everything it reaches: the arrows and objects
// of its up-set. One rule per page, generated here because the selectors
// depend on the category.
const reachCss = pages
  .map((p) => {
    const on = `.diagram:has([data-page="${p}"]:is(:hover, :focus-visible))`;
    return (
      `${on} .arrow[data-reached-by~="${p}"] .stroke` +
      `{stroke:var(--fg);marker-end:url(#nav-head-on)}` +
      `${on} .obj[data-reached-by~="${p}"] text{fill:var(--fg)}`
    );
  })
  .join("");

// Each commuting square gets a ⟲ in its middle, which chases it
// (scripts/chase.ts): an anticlockwise arc with a head, drawn rather than
// typeset so it doesn't depend on the font. The head is part of the path
// (not a marker) so it takes the arc's hover colour. Pointing at one previews both
// of its paths.
const CELL_R = 7;
// The arc runs anticlockwise (decreasing angles, y down) from upper left,
// round the bottom, to upper right, leaving a gap at the top: ↺.
const [ARC_FROM, ARC_TO] = [-120, -60];
const cells = squares().map((sq, i) => {
  const ps = [sq.from, sq.to, ...sq.via].map(pos);
  const cx = ps.reduce((x, p) => x + p.x, 0) / 4;
  const cy = ps.reduce((y, p) => y + p.y, 0) / 4;
  const rad = (deg: number) => (deg * Math.PI) / 180;
  const at = (deg: number) =>
    `${f(cx + CELL_R * Math.cos(rad(deg)))} ${f(cy + CELL_R * Math.sin(rad(deg)))}`;
  // The head, at the arc's end, pointing the way it travels.
  const tip = {
    x: cx + CELL_R * Math.cos(rad(ARC_TO)),
    y: cy + CELL_R * Math.sin(rad(ARC_TO)),
  };
  const heading = Math.atan2(-Math.cos(rad(ARC_TO)), Math.sin(rad(ARC_TO)));
  const barb = (side: number) => {
    const a = heading + Math.PI + side * rad(40);
    return `${f(tip.x + 3.5 * Math.cos(a))} ${f(tip.y + 3.5 * Math.sin(a))}`;
  };
  const path = (via: Page) =>
    [sq.from, via, sq.to].map((p) => meta[p].title).join(" → ");
  return {
    i,
    cx,
    cy,
    d:
      `M ${at(ARC_FROM)} A ${CELL_R} ${CELL_R} 0 1 0 ${at(ARC_TO)} ` +
      `M ${barb(1)} L ${at(ARC_TO)} L ${barb(-1)}`,
    from: sq.from,
    to: sq.to,
    via: sq.via.join(" "),
    label: `Chase this square: ${path(sq.via[0])} equals ${path(sq.via[1])}`,
  };
});

const chaseCss = squares()
  .map((sq, i) => {
    const on = `.diagram:has(.cell[data-square="${i}"]:is(:hover, :focus-visible))`;
    const arrows = sq.via
      .flatMap((v) => [
        `[data-from="${sq.from}"][data-to="${v}"]`,
        `[data-from="${v}"][data-to="${sq.to}"]`,
      ])
      .join(", ");
    return (
      `${on} .arrow:is(${arrows}) .stroke` +
      `{stroke:var(--link);marker-end:url(#nav-head-chase)}`
    );
  })
  .join("");

// The identity loop leaves and re-enters a node on its free side.
const DIRS: Record<Loop, Pt> = {
  up: { x: 0, y: -1 },
  down: { x: 0, y: 1 },
  left: { x: -1, y: 0 },
  right: { x: 1, y: 0 },
};
const loop = (p: Page) => {
  const c = pos(p);
  const d = DIRS[layout[p].loop];
  const n = { x: -d.y, y: d.x }; // perpendicular to d
  const edge = d.x === 0 ? HALF_H : halfW(p);
  const at = (along: number, across: number) => ({
    x: c.x + d.x * (edge + along) + n.x * across,
    y: c.y + d.y * (edge + along) + n.y * across,
  });
  const [s, c1, c2, e] = [at(0, -7), at(LOOP, -21), at(LOOP, 21), at(0, 7)];
  return {
    d: `M ${f(s.x)} ${f(s.y)} C ${f(c1.x)} ${f(c1.y)}, ${f(c2.x)} ${f(c2.y)}, ${f(e.x)} ${f(e.y)}`,
    label: at(LOOP * 0.75 + (d.x === 0 ? 10 : 14), 0),
  };
};

// Bounds cover every node and every page's identity loop, so the diagram is
// the same size on every page.
const extents: Pt[] = pages.flatMap((p) => {
  const c = pos(p);
  const { label } = loop(p);
  return [
    { x: c.x - halfW(p), y: c.y - HALF_H },
    { x: c.x + halfW(p), y: c.y + HALF_H },
    { x: label.x - 10, y: label.y - 10 },
    { x: label.x + 10, y: label.y + 10 },
  ];
});
const minX = Math.min(...extents.map((p) => p.x)) - 2;
const maxX = Math.max(...extents.map((p) => p.x)) + 2;
const minY = Math.min(...extents.map((p) => p.y)) - 2;
const maxY = Math.max(...extents.map((p) => p.y)) + 2;
const viewBox = [minX, minY, maxX - minX, maxY - minY].map(f).join(" ");
---

<nav aria-label="Site" data-page={page}>
  <svg
    class="diagram"
    viewBox={viewBox}
    role="group"
    style={`--w: ${f(maxX - minX)}px; aspect-ratio: ${f(maxX - minX)} / ${f(maxY - minY)}`}
  >
    <style is:inline set:html={reachCss + chaseCss} />
    <defs>
      <marker
        id="nav-head"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path class="head" d="M 1 1 L 9 5 L 1 9"></path>
      </marker>
      <marker
        id="nav-head-id"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path class="head head-id" d="M 1 1 L 9 5 L 1 9"></path>
      </marker>
      <marker
        id="nav-head-on"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path class="head head-on" d="M 1 1 L 9 5 L 1 9"></path>
      </marker>
      <marker
        id="nav-head-chase"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path class="head head-chase" d="M 1 1 L 9 5 L 1 9"></path>
      </marker>
    </defs>

    {
      edges.map((e) => (
        <g
          class="arrow"
          data-reached-by={e.reachedBy}
          data-from={e.from}
          data-to={e.to}
        >
          <title>{e.title}</title>
          <line class="hover" x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} />
          <line
            class="stroke"
            x1={e.x1}
            y1={e.y1}
            x2={e.x2}
            y2={e.y2}
            marker-end="url(#nav-head)"
          />
        </g>
      ))
    }

    {
      pages.map((p) => {
        const { x, y } = pos(p);
        // Hooks for the reachability rules and the keyboard shortcuts.
        const data = {
          "data-page": p,
          "data-reached-by": reachedBy(p),
          "data-col": layout[p].at[0],
          "data-row": layout[p].at[1],
        };
        const box = (
          <rect
            class="hit"
            x={x - halfW(p)}
            y={y - HALF_H}
            width={2 * halfW(p)}
            height={2 * HALF_H}
          />
        );
        const label = (
          <text x={x} y={y}>
            {meta[p].title}
          </text>
        );
        if (p !== page)
          return (
            <a class="obj" href={meta[p].href} {...data}>
              {box}
              {label}
            </a>
          );
        const l = loop(p);
        return (
          <g
            class="obj current"
            tabindex="0"
            aria-current="page"
            aria-label={`${meta[p].title} (current page)`}
            {...data}
          >
            <path
              class="id"
              d={l.d}
              pathLength="1"
              marker-end="url(#nav-head-id)"
            />
            <text class="id-label" x={l.label.x} y={l.label.y}>
              id
            </text>
            {box}
            {label}
          </g>
        );
      })
    }

    {
      /* Hidden until scripts/chase.ts makes them work (data-chase).
         Last, so they tab after the pages and sit on top. */
      cells.map((c) => (
        <g
          class="cell"
          data-square={c.i}
          data-from={c.from}
          data-to={c.to}
          data-via={c.via}
          aria-label={c.label}
        >
          <title>{c.label}</title>
          <circle class="cell-hit" cx={f(c.cx)} cy={f(c.cy)} r="15" />
          <path class="cell-arc" d={c.d} />
        </g>
      ))
    }
  </svg>
  <p class="trail" hidden></p>
  <p class="chase" aria-live="polite" hidden><span></span></p>
</nav>

<style>
  nav {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* The composite of the arrows followed to get here; see scripts/trail.ts.
     And the equation a chase shows (scripts/chase.ts). */
  .trail,
  .chase {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
    text-align: center;
  }

  .diagram {
    display: block;
    width: 100%;
    max-width: var(--w);
    height: auto;
    overflow: visible;
    font-size: 16px;
  }

  text {
    fill: var(--link);
    text-anchor: middle;
    dominant-baseline: central;
  }

  .arrow .stroke {
    stroke: var(--muted);
    stroke-width: 1.25;
    transition: stroke 0.15s;
  }

  /* A wide invisible stroke so the arrow's tooltip is easy to hit. */
  .arrow .hover {
    stroke: transparent;
    stroke-width: 10;
  }

  .arrow:hover .stroke {
    stroke: var(--fg);
  }

  .head {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hit {
    fill: transparent;
  }

  .obj {
    cursor: pointer;
    outline: none;
  }

  .obj:hover text,
  .obj:focus-visible text {
    fill: var(--fg);
    text-decoration: underline;
  }

  .obj:focus-visible .hit {
    stroke: var(--link);
    stroke-width: 1;
    stroke-dasharray: 2 2;
  }

  .current {
    cursor: default;
  }

  .current text {
    fill: var(--fg);
    font-weight: 700;
  }

  .current:hover text,
  .current:focus-visible text {
    text-decoration: none;
  }

  /* The identity arrow draws itself when you point at where you already are. */
  .id {
    fill: none;
    stroke: var(--link);
    stroke-width: 1.25;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    transition:
      stroke-dashoffset 0.35s ease-out,
      opacity 0.15s;
  }

  .head-id {
    stroke: var(--link);
  }

  .head-on {
    stroke: var(--fg);
  }

  .head-chase {
    stroke: var(--link);
  }

  /* The ⟲ in each commuting square. */
  .cell {
    visibility: hidden;
    cursor: pointer;
    outline: none;
  }

  .diagram[data-chase] .cell {
    visibility: visible;
  }

  .cell-hit {
    fill: transparent;
  }

  .cell-arc {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.15s;
  }

  .cell:hover .cell-arc,
  .cell:focus-visible .cell-arc {
    stroke: var(--link);
  }

  .cell:focus-visible .cell-hit {
    stroke: var(--link);
    stroke-width: 1;
    stroke-dasharray: 2 2;
  }

  /* A chase (scripts/chase.ts): both paths lit, the corner where the dots
     meet, and the ⟲ turning once. */
  .arrow.chasing .stroke {
    stroke: var(--link);
    stroke-width: 1.5;
    marker-end: url(#nav-head-chase);
  }

  .obj.meet text {
    fill: var(--link);
    font-weight: 700;
    transform-box: fill-box;
    transform-origin: center;
    animation: meet 0.45s ease-out;
  }

  @keyframes meet {
    40% {
      transform: scale(1.2);
    }
  }

  .cell.spin .cell-arc {
    stroke: var(--link);
    transform-box: fill-box;
    transform-origin: center;
    animation: spin 0.6s ease-in-out;
  }

  @keyframes spin {
    to {
      transform: rotate(-360deg);
    }
  }

  /* The chase's equation opens up (moving what's around it smoothly) and
     then fades in; going, it fades and then closes. It's always in the
     layout once scripts/chase.ts runs, at zero height until .shown. */
  .chase {
    display: grid;
    grid-template-rows: 0fr;
    margin: 0;
    color: var(--link);
    opacity: 0;
    transition:
      opacity 0.2s ease,
      grid-template-rows 0.35s ease 0.1s,
      margin-top 0.35s ease 0.1s;
  }

  .chase[hidden] {
    display: none;
  }

  .chase.shown {
    grid-template-rows: 1fr;
    margin-top: 0.25rem;
    opacity: 1;
    transition:
      grid-template-rows 0.35s ease,
      margin-top 0.35s ease,
      opacity 0.3s ease 0.15s;
  }

  .chase > span {
    min-height: 0;
    overflow: hidden;
  }

  .current text.id-label {
    fill: var(--link);
    font-weight: 400;
    font-style: italic;
    opacity: 0;
    transition: opacity 0.2s 0.15s;
  }

  .current:hover .id,
  .current:focus-visible .id {
    stroke-dashoffset: 0;
    opacity: 1;
  }

  .current:hover .id-label,
  .current:focus-visible .id-label {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .id,
    .current text.id-label,
    .cell-arc {
      transition: none;
    }

    .obj.meet text,
    .cell.spin .cell-arc {
      animation: none;
    }

    .chase,
    .chase.shown {
      transition: none;
    }
  }
</style>
